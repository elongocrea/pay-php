{
    "name": "elongo/pay-php",
    "description": "SDK PHP officiel pour Elongo Pay — sessions de checkout et vérification des webhooks.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Elongo\\Pay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elongo\\Pay\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
